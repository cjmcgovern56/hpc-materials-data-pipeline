&CONTROL
    calculation = "scf"
    prefix      = "SiC_scf"
    pseudo_dir  = "../pseudo/"
    outdir      = "./"
    forc_conv_thr = 0.0001
/

&SYSTEM
    ecutwfc                   = 80 
    ibrav                     = 2
    nat                       = 2
    smearing                  = 'gaussian'
    degauss                   = 0.01
    occupations               ='smearing'
    ntyp                      = 2
    nbnd                      = 8
    nspin                     = 1
    celldm(1)                 = 8.23 ! initial guess (Bohr)
/

&ELECTRONS
  conv_thr = 1.0d-8
/

&IONS
/

&CELL
/

K_POINTS AUTOMATIC
6 6 6  0 0 0 !tested all availible k_points points: 4x4x4, 6x6x6 & 8x8x8

ATOMIC_SPECIES
Si 28.085 Si.upf
C 12.0107 C.upf

ATOMIC_POSITIONS {crystal}
Si      0.0000000000    0.0000000000    0.0000000000
C       0.2500000000    0.2500000000    0.2500000000
